{
  "installCommand": "cd starter/client && npm install",
  "buildCommand": "npm run build --prefix starter/client",
  "outputDirectory": "starter/client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-API.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}