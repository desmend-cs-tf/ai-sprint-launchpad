# ─────────────────────────────────────────────────────────────
# Copy this file to server/.env  (cp .env.example server/.env)
# NEVER commit .env. NEVER put these keys in client/ code.
# Every value is optional: with nothing filled in, the app runs
# in "demo mode" (in-memory data + canned AI replies).
# ─────────────────────────────────────────────────────────────

PORT=3001

# ── AI providers (fill in at least ONE for real AI answers) ──
# The server tries them in this order and falls back if one fails.
AI_PROVIDER_ORDER=gemini,groq,openrouter

# Google AI Studio → https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq → https://console.groq.com/keys  (free tier, very fast)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter → https://openrouter.ai/keys  (models ending in ":free" cost $0)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Model IDs change often. If you get a "model not found" error,
# open the provider's models page and paste a current ID above.

# ── Supabase (optional — leave blank to use in-memory data) ──
# Dashboard → Project Settings → API
SUPABASE_URL=
# Use the SERVICE ROLE / SECRET key here. It bypasses Row Level Security,
# so it must only ever live on the server.
SUPABASE_SERVICE_KEY=
